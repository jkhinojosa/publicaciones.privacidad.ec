{% set id = id|default('hero') %}
{% set content = content|default(page.content) %}

{% if page.header.hero_style == 'apple' or id == 'blog-hero' %}
<section id="{{ id }}" class="apple-privacy-hero">
    <div class="apple-hero-container">
        <span class="apple-hero-eyebrow">{{ page.header.eyebrow|default('Privacidad') }}</span>
        <h1 class="apple-hero-title">{{ page.header.hero_title|default(page.title) }}</h1>
        {% if page.header.hero_subtitle or page.header.subtitle %}
            <p class="apple-hero-subtitle">{{ page.header.hero_subtitle|default(page.header.subtitle) }}</p>
        {% endif %}

        {% if hero_image %}
        <div class="apple-hero-media">
            <img src="{{ hero_image.url }}" alt="{{ page.title|e('html_attr') }}" class="apple-hero-portrait" />
        </div>
        {% endif %}

        {% if content|striptags|trim is not empty %}
        <div class="apple-hero-extra">
            {{ content|raw }}
        </div>
        {% endif %}
    </div>
</section>
{% else %}
<section id="{{ id }}"
         class="section modular-hero hero {{ page.header.hero_classes }} {{ page.header.background.parallax ? 'parallax' : '' }}"
         {% if hero_image %}style="background-image: url('{{ hero_image.url }}');"{% endif %}>
    {% if hero_image %}<div class="image-overlay"></div>{% endif %}
    <div class="container" style="text-align: {{ page.header.hero_align|default('center') }}">
        {{ content|raw }}
    </div>
    <i id="to-start" class="pulse fa-solid fa-angle-down" aria-hidden="true"></i>
</section>
{% endif %}
